# ====================================================================
# PyroGuard AI - Environment Configuration Template
# ====================================================================

# Node Environment ('development' or 'production')
NODE_ENV=development

# Backend REST API Port
PORT=5000

# Security Secrets (Generate a 64+ char random string in production)
JWT_SECRET=pyroguard-dev-super-secure-jwt-secret-key-2026-sih
JWT_EXPIRES_IN=7d

# Machine Learning Microservice URL
ML_SERVICE_URL=http://127.0.0.1:8000

# SQLite Database File Path
DATABASE_PATH=../database/pyroguard.sqlite

# Optional: PostgreSQL Database URL (used for enterprise deployments)
# DATABASE_URL=postgresql://pyroguard:pyroguard_secure_password@localhost:5432/pyroguard_db

# Frontend URLs for CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=*

# Optional: NASA FIRMS Map Key (Register at https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# If left blank, the platform automatically serves calibrated satellite swaths
NASA_FIRMS_MAP_KEY=

# ── SMS Alert Configuration ──────────────────────────────────────────────────
# Enable/disable SMS alerts for high-risk thermal events
SMS_ALERT_ENABLED=false

# Risk score threshold for triggering SMS (0-100, default: 75)
SMS_RISK_THRESHOLD=75

# Comma-separated recipient phone numbers in E.164 format
SMS_ALERT_RECIPIENTS=+919876543210,+919123456789

# Alert provider: TWILIO (SMS) | TWILIO_WHATSAPP | TELEGRAM
SMS_PROVIDER=TWILIO

# Twilio Credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ── Telegram Alert Channel ───────────────────────────────────────────────────
# Used when SMS_PROVIDER=TELEGRAM. Both values are required — the chat ID is
# only added to the recipient list while the provider is set to TELEGRAM, so
# leaving SMS_PROVIDER=TWILIO produces "No recipients configured" in the
# in-app alert console.
#
# 1. Create a bot with @BotFather in Telegram to obtain the token.
# 2. Send your bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
#    (group chat IDs are negative — keep the minus sign).
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
